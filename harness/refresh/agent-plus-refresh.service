# Runs `cargo xtask refresh` in a checkout of its own: a worktree of the
# repository that every worker's worktree comes from, so that it takes the same
# merge slot. Each run moves the checkout to the newest `main` first. HARNESS.md
# says how the owner turns it on.
[Unit]
Description=Agent+ refresh, which proves and merges the PRs the owner approved

[Service]
Type=oneshot
WorkingDirectory=%h/agent-plus-refresh
# Only into this checkout's FETCH_HEAD, so that it takes no lock in the shared
# git directory that a merge needs.
ExecStartPre=git fetch -q --no-tags --no-auto-maintenance --refmap= origin main
ExecStartPre=git checkout -q --detach FETCH_HEAD
ExecStart=cargo xtask refresh
